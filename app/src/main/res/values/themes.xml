<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Glavna tema aplikacije -->
    <style name="Base.Theme.AutobahnInfo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/plava</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:colorBackground">@color/pozadina</item>
        <item name="android:windowBackground">@color/pozadina</item>
        <item name="android:textColorPrimary">@color/tekst</item>
        <item name="android:textColorSecondary">@color/tekst_sekundarni</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.AutobahnInfo" parent="Base.Theme.AutobahnInfo" />

    <!-- Tekst na štitu autoputa ("A 8") -->
    <style name="Stit">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Dugmad-pilule u plavom zaglavlju i filteri -->
    <style name="Pilula" parent="Widget.Material3.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
