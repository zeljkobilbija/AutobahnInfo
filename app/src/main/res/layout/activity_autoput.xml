<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina_liste"
    android:orientation="vertical"
    tools:context=".AutoputActivity">

    <!-- Plavo zaglavlje -->
    <LinearLayout
        android:id="@+id/zaglavlje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/plava"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/nazad"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_okrugli_taster"
                android:contentDescription="@string/nazad"
                android:src="@drawable/ic_nazad" />

            <TextView
                android:id="@+id/stit"
                style="@style/Stit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_stit"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textSize="26sp"
                tools:text="A 8" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ruta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Luxemburg – Salzburg" />

                <TextView
                    android:id="@+id/podnaslov"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/plava_svetla"
                    android:textSize="13sp"
                    tools:text="40 izlaza · 12 pumpi u ovom smeru" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/deonice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:text="@string/smer_voznje"
            android:textAllCaps="true"
            android:textColor="@color/plava_svetla"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/smerovi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_smer"
            android:orientation="horizontal"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Filteri -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/povrsina"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filteri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/linija" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/prazno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:text="@string/nema_stavki"
            android:textColor="@color/tekst_sekundarni"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/reklamaKontejner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
